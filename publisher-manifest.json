          "body": "<style>\n  :root{--slate-950:#131a1f;--slate-900:#1b242b;--slate-800:#26323a;--slate-700:#3a4952;--slate-500:#6b7b85;--slate-300:#b9c4ca;--slate-200:#d5dde1;--slate-100:#e7ecee;--paper:#f4f6f7;--cyan:#0f9ba8;--cyan-deep:#0b7c86;--cyan-soft:#cfe8ea;--line:#cfd8dc}\n  *{box-sizing:border-box}\n  html{-webkit-text-size-adjust:100%}\n  body{margin:0;background:var(--paper);color:var(--slate-900);font-family:\"Helvetica Neue\",Helvetica,\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",sans-serif;font-size:16px;line-height:1.7}\n  a{color:var(--cyan-deep);text-decoration:none;border-bottom:1px solid rgba(11,124,134,.35)}\n  a:hover{color:var(--slate-950);border-bottom-color:var(--slate-950)}\n  h1,h2,h3{line-height:1.25;margin:0;font-weight:700;letter-spacing:-.01em}\n  p{margin:0}\n  ul{margin:0;padding:0;list-style:none}\n\n  .wrap{width:100%;max-width:1120px;margin:0 auto;padding:0 20px}\n\n  /* 顶部面包屑 + 目录 */\n  .topbar{background:var(--slate-950);color:var(--slate-200);border-bottom:3px solid var(--cyan)}\n  .crumb{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:12.5px;letter-spacing:.04em;padding:12px 0 10px;color:var(--slate-300)}\n  .crumb a{color:var(--slate-200);border-bottom:1px dotted var(--slate-500)}\n  .crumb a:hover{color:#fff;border-bottom-color:var(--cyan)}\n  .crumb .sep{color:var(--slate-700)}\n  .crumb .now{color:var(--cyan)}\n  .toc{display:flex;gap:6px 0;flex-wrap:wrap;border-top:1px solid var(--slate-800);padding:10px 0 12px}\n  .toc li{margin-right:22px;font-size:13px}\n  .toc a{color:var(--slate-300);border-bottom:none}\n  .toc a::before{content:\"／\";color:var(--slate-700);margin-right:6px}\n  .toc a:hover{color:var(--cyan)}\n\n  /* 首屏：杂志式多栏网格 */\n  .hero{padding:44px 0 12px}\n  .hero-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:22px 24px}\n  .hero-kicker{grid-column:1 / span 12;font-size:12.5px;letter-spacing:.22em;text-transform:uppercase;color:var(--cyan-deep);border-bottom:1px solid va